# Çalıştırılacak model (Hugging Face model kimliği)
MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct

# GGUF model kullanılacaksa dosya adı (boş bırakılırsa transformers kullanılır)
MODEL_FILE=

# Erişim izni gerektiren (gated) modeller için Hugging Face token'ı
HF_TOKEN=

# auto | cpu | cuda
DEVICE=auto

# Bağlam uzunluğu ve üretim ayarları
MAX_CONTEXT=4096
MAX_NEW_TOKENS=1024
TEMPERATURE=0.7

# Portlar
WEB_PORT=3000
API_PORT=8000

# Güvenlik
# 127.0.0.1: yalnızca bu bilgisayardan erişilir. 0.0.0.0: ağdaki herkes erişebilir;
# API'de parola olmadığı için yalnızca güvendiğiniz bir ağda kullanın.
BIND_ADDRESS=127.0.0.1
# API'yi başka bir adresteki web uygulamasından çağıracaksanız izin verilen kökenler
# (virgülle ayrılmış, ör. http://localhost:5173). Liman arayüzü için gerekmez.
CORS_ORIGINS=
